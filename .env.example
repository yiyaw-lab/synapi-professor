# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored — never commit your real bot token.

# ── Required ────────────────────────────────────────────────────────────────
# Create a bot with @BotFather (https://t.me/BotFather) and paste its token.
TELEGRAM_BOT_TOKEN=

# Your chat ID. Message your bot, then open
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# and copy the "chat":{"id": ...} value.
TELEGRAM_CHAT_ID=

# ── Personalization (optional) ──────────────────────────────────────────────
# Your name, used in the greeting. Leave empty for a name-less greeting
# ("Good morning."). Example: RECIPIENT_NAME=Sam  ->  "Good morning, Sam."
RECIPIENT_NAME=

# The opening line's tone. Default: "Good morning".
# Examples: GREETING=Hey   GREETING=Hi there   GREETING=Good evening
GREETING=Good morning

# ── Curriculum track (optional) ─────────────────────────────────────────────
# Which curriculum to send: "foundation" (how LLMs work, from tokens up) or
# "advanced" (post-training, efficiency, interpretability, agents). Default:
# foundation.
CURRICULUM=foundation

# ── Lab links (optional) ────────────────────────────────────────────────────
# Used to build the Colab/GitHub lab links in each message. Point these at your
# own fork if you host your own copy of the notebooks.
GITHUB_REPO=yiyaw-lab/synapi-professor
GITHUB_BRANCH=main

# ── Advanced (optional) ─────────────────────────────────────────────────────
# Override the Telegram API host (e.g. for a local test server).
TELEGRAM_API_BASE_URL=https://api.telegram.org
